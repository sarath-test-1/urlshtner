{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "URL Shortener with Analytics - Portfolio Project",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "email:worker": "nodemon workers/welcomeEmail.worker.js",
    "analytics-cleanup:worker": "nodemon workers/analyticsCleanup.worker.js",
    "record-click:worker": "nodemon workers/recordClick.worker.js",
    "start": "node server.js",
    "seed": "node seeders/index.js",
    "seed:users": "node seeders/index.js users",
    "db:reset": "node scripts/resetDatabase.js",
    "seed:fresh": "npm run db:reset && npm run seed",
    "docs:generate": "node scripts/generate-docs.js controllers docs",
    "docs:build": "npm run docs:generate",
    "docs:watch": "nodemon --watch controllers --watch services --ext js --exec 'npm run docs:generate'",
    "docs:validate": "swagger-parser validate docs/openapi-generated.json",
    "docs:export": "redoc-cli build docs/openapi-generated.json --output docs/api-docs.html",
    "docs:postman": "node scripts/generate-postman.js docs/openapi-generated.json docs",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:auth": "cross-env NODE_ENV=test jest tests/integration/auth.test.js",
    "test:users": "cross-env NODE_ENV=test jest tests/integration/user.test.js",
    "test:urls": "cross-env NODE_ENV=test jest tests/integration/urls.test.js",
    "test:redirect": "cross-env NODE_ENV=test jest tests/integration/redirect.test.js",
    "test:click-recording": "cross-env NODE_ENV=test jest tests/unit/clickRecording.test.js",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration/",
    "test:unit": "cross-env NODE_ENV=test jest tests/unit/"
  },
  "keywords": [
    "url-shortener",
    "mern",
    "portfolio"
  ],
  "author": "Sarath",
  "license": "MIT",
  "dependencies": {
    "@bull-board/api": "^6.16.2",
    "@bull-board/express": "^9.8.0",
    "@logtail/winston": "^0.5.6",
    "@sentry/node": "^10.12.0",
    "@sentry/profiling-node": "^10.12.0",
    "@upstash/redis": "^1.36.0",
    "base62-random": "^0.3.5",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.66.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "geoip-lite": "^2.0.3",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "morgan": "^1.10.1",
    "nodemailer": "^10.0.1",
    "redis": "^5.8.2",
    "request-ip": "^3.3.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.7",
    "validator": "^13.15.26",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "jest": "^30.1.3",
    "mongodb-memory-server": "^10.2.1",
    "nodemon": "^3.1.10",
    "redoc-cli": "^0.13.21",
    "supertest": "^7.1.4",
    "swagger-parser": "^10.0.3"
  }
}
